{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "newwebsite",
  "main": "worker.js",
  "compatibility_date": "2024-11-11",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/music/*"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.5,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.5,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  }
}
